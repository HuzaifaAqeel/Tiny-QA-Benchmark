# Copy to .env and fill in. Any LiteLLM-supported provider key works —
# the evaluator and generator accept any litellm model id (e.g.
# "gpt-4o-mini", "gemini/gemini-2.5-flash", "anthropic/claude-...").
# The mock demo (examples/run_demo_eval.py) needs no key.
OPENAI_API_KEY=
